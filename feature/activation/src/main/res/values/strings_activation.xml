    <string name="send_title">Send it from your phone</string>
    <string name="send_step_scan">Scan the code with your phone camera</string>
    <string name="send_step_ids">Enter the MAC address and device key</string>
    <string name="send_step_play">Add the source and play it on this device</string>
    <string name="add_heading">Add your playlist</string>
    <string name="add_sub">Choose the kind of source to add</string>
